{
  "name": "mangafire-api",
  "version": "2.0.0",
  "private": true,
  "description": "MangaFire.to scraper API — Express + Playwright. Drives a real browser to intercept the SPA's vrf-protected internal APIs. Deploy on Render (Docker).",
  "scripts": {
    "build": "tsc",
    "start": "node dist/api/index.js",
    "dev": "ts-node-dev --respawn --transpile-only api/index.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axios": "^1.4.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "http-errors": "^2.0.0",
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/http-errors": "^2.0.0",
    "@types/node": "^20.4.8",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6"
  }
}
